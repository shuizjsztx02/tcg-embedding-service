# 服务配置
USE_GPU=false
MATCH_TAU=0.775
MATCH_MARGIN=0.02
# v2 识别阈值
TAU_HIGH=0.87
TAU_LOW=0.75
MARGIN_HIGH=0.02
PORT=8056

# 品类数据根目录（按品类组织子目录）
DATA_DIR=/data

# 模型目录（挂载卷）
MODEL_DIR=/models
BGE_MODEL_PATH=/models/bge_model
PPOCR_MODEL_DIR=/models/ppocr_models

# LLM 端点（品类判断 + 兜底识图）
LLM_BASE_URL=http://127.0.0.1:15721
LLM_CATEGORY_MODEL=qwen3.7-flash
LLM_FALLBACK_MODEL=qwen3.7-flash
LLM_TIMEOUT_S=30
# 价格快照日期（asOf 字段）
PRICE_AS_OF=2026-09-01